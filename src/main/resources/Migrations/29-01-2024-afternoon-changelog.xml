<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1730212576592-1" author="pedro.monteiro">
        <createTable tableName="agreement">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_agreement"/>
            </column>
            <column name="createdOn" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="lastUpdated" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="tenantID" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="dbStatus" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="agreementCode" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="agreementName" type="VARCHAR(255)"/>
            <column name="agreementDescription" type="VARCHAR(255)"/>
            <column name="agreementDays" type="INT"/>
            <column name="endMonth" type="INT"/>
            <column name="nextMonth" type="INT"/>
            <column name="fixDay" type="INT"/>
        </createTable>
    </changeSet>
